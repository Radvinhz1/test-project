# Copy to .env. Keep your real token out of Git and chat messages.
BOT_TOKEN=PUT_YOUR_BOTFATHER_TOKEN_HERE
# Your numeric Telegram user ID, NOT the bot ID or username.
# Obtain it with: python bot.py --setup, then send /id to your bot.
ADMIN_IDS=

# Windows LocalDB on this computer, using your Windows account.
SQL_SERVER=(localdb)\MSSQLLocalDB
SQL_DATABASE=TelegramUploader
SQL_DRIVER=ODBC Driver 18 for SQL Server
# For this local development instance only. Use a trusted certificate on a server.
SQL_TRUST_SERVER_CERTIFICATE=yes
